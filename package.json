{
  "name": "my-portfolio",
  "version": "1.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "cross-env ANALYZE=true next build",
    "build": "next build",
    "dev": "next dev",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,mjs,css,html,md,json,yml,yaml}\"",
    "lint": "eslint --fix --cache \"src/**/*.{js,ts,jsx,tsx}\"",
    "prepare": "simple-git-hooks",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run typecheck",
    "pre-push": "npm run lint && npm run build"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "**/*.{css,html,json,md,mjs,yml,yaml}": "prettier --write"
  },
  "browserslist": [
    "chrome >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "edge >= 93"
  ],
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/bundle-analyzer": "^16.3.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.3.6",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tailwind-canonical-classes": "^1.4.1",
    "globals": "^17.12.0",
    "lint-staged": "^17.5.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "esbuild": false,
    "simple-git-hooks": true,
    "unrs-resolver": true
  }
}
